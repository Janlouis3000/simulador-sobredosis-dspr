{
  "name": "simulador-sobredosis-dspr",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador educativo de respuesta a sobredosis (DSPR, Departamento de Salud de Puerto Rico)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:arbol": "vite build --config vite.arbol.config.js",
    "build:web": "vite build --config vite.web.config.js",
    "test:e2e": "vite build --config vite.web.config.js && playwright test",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "validar": "vitest run src/sim/arbol/validar.test.ts",
    "calibrar": "node scripts/calibrar.js",
    "comprimir": "node scripts/comprimir.js",
    "inventario": "node scripts/inventario.js",
    "escenarios": "node scripts/blender.js blender/generar_escenarios.py --out modelos",
    "miniaturas": "node scripts/blender.js blender/miniaturas_escenarios.py --glb modelos --out src/assets"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "meshoptimizer": "1.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
